{
  "name": "anibox",
  "private": true,
  "version": "1.0.8",
  "type": "module",
  "main": "electron/main.cjs",
  "repository": "https://github.com/zorai81hz/anibox",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "electron:build": "rimraf release && vite build && electron-builder"
  },
  "dependencies": {
    "anilibria-api-wrapper": "^1.1.0",
    "aniparsec-ru": "^1.0.8",
    "dotenv": "^16.4.5",
    "framer-motion": "^11.3.28",
    "hls.js": "^1.5.13",
    "lucide-react": "^0.427.0",
    "node-fetch": "^3.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "electron-updater": "^6.2.1",
    "postcss": "^8.4.41",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.10",
    "vite": "^5.4.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.anibox.app",
    "productName": "AniBox",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "zorai81hz",
        "repo": "anibox",
        "releaseType": "release"
      }
    ]
  }
}
